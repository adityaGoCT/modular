load("//bazel:api.bzl", "mojo_library", "pkg_files")

package(default_visibility = ["//max:consumers"])

# Also the base of the HAL overlay in
# //max/mojo/max/_driver/max_license:max_srcs_hal, which the `//max:max_mojo`
# alias selects under --config=hal-device-context.
filegroup(
    name = "max_srcs",
    srcs = glob(["**/*.mojo"]) + ["//max/mojo/max/_driver/max_license:srcs"],
    visibility = ["//visibility:public"],
)

mojo_library(
    name = "max",
    # With --//:hal_device_context=true, the HAL overlay, so that MAX's kernel
    # packages build against the DeviceContext the runtime provides (the
    # `//max:max_mojo` alias that does this internally is not in this tree).
    srcs = select({
        "//:hal_device_context_enabled": ["//max/mojo/max/_driver/max_license:max_srcs_hal"],
        "//conditions:default": [":max_srcs"],
    }),
    docs_base_path = "mojo",
    deps = [
        "//MLRT:Driver/DeviceContext",
        "@mojo//:std",
    ],
)

pkg_files(
    name = "docs",
    srcs = [":max.docs"],
    prefix = "api/mojo",
    renames = {
        ":max.docs": "max",
    },
    tags = ["manual"],
)

# Renders `max` first and pre-expanded, so its subpackages read as children
# rather than as siblings of the other top-level packages.
pkg_files(
    name = "category.docs",
    srcs = ["_category_.json"],
    prefix = "api/mojo/max",
    tags = ["manual"],
)
